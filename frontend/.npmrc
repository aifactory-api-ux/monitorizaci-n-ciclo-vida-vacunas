; El entorno de entrega define NODE_ENV=production, lo que hace que npm omita
; las devDependencies (Vite, Vitest, TypeScript, Testing Library) y rompa la
; verificación de `npm ci`, `npm test` y `npm run build`. Se fuerza su inclusión
; de forma explícita; un `--omit=dev` en la línea de comandos sigue mandando.
include=dev
