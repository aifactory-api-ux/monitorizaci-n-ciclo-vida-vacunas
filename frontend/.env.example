VITE_APP_NAME="Vaccine Batch Tracking"

# URL base de la API del BFF. En desarrollo se usa el proxy de Vite (ver
# vite.config.ts); en el despliegue de contenedor apunta al servicio `bff`.
VITE_API_BASE_URL=/api/v1

# Credenciales del canal WebSocket Reverb. Son obligatorias para conectar con
# el canal privado `batch-monitoring`.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Servidor de desarrollo al que se reenvían las peticiones del proxy de Vite.
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000
VITE_DEV_REVERB_URL=ws://127.0.0.1:8080
