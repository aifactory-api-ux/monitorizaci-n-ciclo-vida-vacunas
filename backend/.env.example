APP_NAME="Vaccine Batch Tracking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Destino del log de auditoría estructurado en JSON (véase D10). Por defecto
# stdout, que es lo que recolecta el agregador de logs del despliegue.
AUDIT_JSON_STREAM=php://stdout

# Desarrollo local sin MySQL ni Redis. El despliegue de contenedor usa el
# gestor de secretos y no monta ningún fichero .env (véase D16).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vaccine_batch
# DB_USERNAME=
# DB_PASSWORD=

CACHE_STORE=file
CACHE_PREFIX=

QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# `log` en desarrollo; `redis` en el despliegue de contenedor.
BROADCAST_CONNECTION=log
# BROADCAST_REDIS_CONNECTION=default

FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Credenciales del servidor Reverb; obligatorias cuando BROADCAST_CONNECTION=reverb.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Integración de solo lectura con el LIMS Labware.
LIMS_ENABLED=false
LIMS_BASE_URL=
LIMS_API_TOKEN=

# Vigencia en minutos de los tokens de acceso emitidos por Passport (D9).
API_TOKEN_TTL_MINUTES=60

# Firmas de los tokens JWT de Passport. Si no se informan, Passport usa las
# claves del almacenamiento local de la aplicación, que no se versionan.
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=

# Monitorización de la planta: umbrales de las alertas operativas de prioridad
# máxima, fichero de lecturas y canales de notificación. Los destinatarios se
# declaran como una lista separada por comas; un canal habilitado sin
# destinatarios hace fallar el arranque con un error explícito.
MONITORING_THERMAL_DEVIATION_THRESHOLD=2.0
MONITORING_SPHEREON_ANOMALY_THRESHOLD=5.0
MONITORING_FEED_PATH=
MONITORING_EMAIL_ENABLED=false
MONITORING_EMAIL_RECIPIENTS=
MONITORING_SMS_ENABLED=false
MONITORING_SMS_RECIPIENTS=

# Gestor de secretos (HashiCorp Vault) del despliegue de producción. Con
# SECRETS_ENABLED la aplicación exige en el arranque todas las credenciales
# obligatorias del despliegue (D16): si falta alguna, no arranca y no usa
# ningún valor de reserva.
SECRETS_ENABLED=false
VAULT_ADDR=
VAULT_MOUNT=msd
VAULT_TOKEN=
VAULT_TOKEN_FILE=
VAULT_TIMEOUT=5

# Contraseña inicial de los usuarios sembrados (`db:seed`). La inyecta el
# gestor de secretos del despliegue: el seeder falla con un error explícito
# si la variable no está informada.
APP_USER_SEED_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
