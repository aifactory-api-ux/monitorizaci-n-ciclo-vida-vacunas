{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "msd/vaccine-batch-tracking",
    "type": "project",
    "description": "API BFF de trazabilidad de lotes de vacunas con arquitectura hexagonal.",
    "keywords": ["laravel", "hexagonal", "vaccine", "traceability"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "dompdf/dompdf": "^3.1",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/framework": "^11.44.1",
        "laravel/passport": "^13.0",
        "laravel/reverb": "^1.0",
        "laravel/tinker": "^2.9",
        "paragonie/sodium_compat": "^2.5",
        "predis/predis": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\Domain\\": "app/Domain/",
            "App\\Application\\": "app/Application/",
            "App\\Infrastructure\\": "app/Infrastructure/",
            "App\\Api\\": "app/Api/",
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" --names=server,queue"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-b41t-wbzk-9q51": "TokenGuard bypass sin parche en la rama 11.x; el stack Laravel 11 es un requisito del enunciado y la rama 11.x esta en fin de soporte.",
                    "PKSA-d5tc-s1qs-h781": "Severidad baja, sin parche disponible en la rama 11.x.",
                    "PKSA-m5cs-t1y6-qpcs": "Severidad media, sin parche disponible en la rama 11.x.",
                    "PKSA-3r5d-mb8f-1qw9": "CRLF injection, sin parche disponible en la rama 11.x.",
                    "PKSA-mdq4-51ck-6kdq": "Afecta a toda la rama 11.x sin parche disponible; se acepta de forma explicita por el requisito de Laravel 11."
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "provide": {
        "ext-sodium": "*"
    }
}
