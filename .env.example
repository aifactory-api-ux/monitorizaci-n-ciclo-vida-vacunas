# Variables del despliegue de contenedor. Copiar a `.env` y completar los
# valores obligatorios. En producción el gestor de secretos (D16) sustituye a
# este fichero; no se monta ningún `.env` dentro de los contenedores.

APP_NAME="Vaccine Batch Tracking"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
LOG_CHANNEL=stack
LOG_LEVEL=info

# Puertos publicados en el host
FRONTEND_PORT=8080
BFF_HTTP_PORT=8081
MYSQL_PORT=3306
REDIS_PORT=6379

# MySQL 8.0
DB_DATABASE=vaccine_batch
DB_USERNAME=vaccine_batch
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Caché, cola y sesión sobre Redis 7; el broadcasting llega al cliente por
# Reverb, que usa Redis para propagar los eventos entre réplicas del BFF.
CACHE_PREFIX=vaccine_batch_cache

# Gestor de secretos del despliegue: con SECRETS_ENABLED la aplicación exige
# en el arranque todas las credenciales obligatorias y no usa ningún valor de
# reserva (D16). Los valores los inyecta el gestor, no este fichero.
SECRETS_ENABLED=true
VAULT_ADDR=
VAULT_MOUNT=msd
VAULT_TOKEN=
VAULT_TOKEN_FILE=

# Credenciales del servidor Reverb (WebSocket)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SCHEME=http
# Orquestación de los eventos entre réplicas del BFF mediante Redis
REVERB_SCALING_ENABLED=true

# Configuración del SPA en tiempo de compilación
VITE_API_BASE_URL=/api/v1
# El SPA se sirve en el puerto publicado del `frontend` y abre el canal
# WebSocket contra ese mismo origen: si cambia `FRONTEND_PORT`, debe cambiar
# también `VITE_REVERB_PORT`.
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Integración de solo lectura con el LIMS Labware
LIMS_ENABLED=false
LIMS_BASE_URL=
LIMS_API_TOKEN=

# Vigencia en minutos de los tokens de acceso emitidos por Passport (D9)
API_TOKEN_TTL_MINUTES=60

# Monitorización de lotes: umbrales de alerta y canales de notificación
MONITORING_THERMAL_DEVIATION_THRESHOLD=2.0
MONITORING_SPHEREON_ANOMALY_THRESHOLD=5.0
MONITORING_FEED_PATH=
MONITORING_EMAIL_ENABLED=false
MONITORING_EMAIL_RECIPIENTS=
MONITORING_SMS_ENABLED=false
MONITORING_SMS_RECIPIENTS=
