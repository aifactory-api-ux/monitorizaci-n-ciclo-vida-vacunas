        "page_structure": [
          {
            "id": "dashboard-principal",
            "name": "Dashboard Principal",
            "purpose": "Reacomodar el Dashboard Principal para eliminar la percepci\u00f3n de elementos colapsados, con mejor densidad, espaciado y jerarqu\u00eda visual manteniendo KPIs, filtros, alertas y tabla de lotes activos.",
            "sections": [
              "Barra de navegaci\u00f3n lateral colapsable y topbar global",
              "Panel de KPIs de producci\u00f3n",
              "Barra de filtros por especie, fase y estado",
              "Banner de alertas prioritarias",
              "Tabla de lotes activos con badges de estado",
              "Indicador de sincronizaci\u00f3n en tiempo real"
            ]
          },
          {
            "id": "detalle-lote",
            "name": "Detalle del Lote",
            "purpose": "Mostrar la trazabilidad completa de un lote seleccionado: fase actual, transiciones entre campus, resultados LIMS y auditor\u00eda inmutable de eventos.",
            "sections": [
              "Cabecera de lote con producto y tecnolog\u00eda",
              "Stepper horizontal de fases entre los tres campus",
              "Indicadores de fechas y dosis objetivo",
              "Panel LIMS de solo lectura",
              "L\u00ednea de tiempo de auditor\u00eda",
              "Panel de alertas y desviaciones del lote"
            ]
          }
        ],
        "base_components": [
          {
            "name": "SidebarNav",
            "role": "Navegaci\u00f3n primaria del sistema; fija, colapsable y con estado activo visible.",
            "props": [
              "items: NavItem[]",
              "collapsed?: boolean",
              "activePath: string",
              "onToggle?: () => void"
            ],
            "notes": "Incluye logo MSD, etiquetas accesibles y modo compacto de \u00edconos. La variante m\u00f3vil se comporta como drawer."
          },
          {
            "name": "Topbar",
            "role": "Cabecera global con perfil, notificaciones y acciones contextuales.",
            "props": [
              "user: UserProfile",
              "notifications: AlertNotification[]",
              "onToggleSidebar?: () => void"
            ],
            "notes": "La campana de notificaciones usa badge num\u00e9rico y agrupa alertas cr\u00edticas. Debe ser clara en contrastes AA."
          },
          {
            "name": "Button",
            "role": "CTA y acci\u00f3n principal o secundaria en todo el sistema.",
            "props": [
              "label: string",
              "variant?: 'primary' | 'secondary' | 'ghost' | 'danger'",
              "icon?: ReactNode",
              "loading?: boolean",
              "disabled?: boolean"
            ],
            "notes": "El primary se reserva para acciones principales del flujo. Estados loading y disabled quedan definidos visualmente."
          },
          {
            "name": "KpiCard",
            "role": "Tarjeta de m\u00e9trica resumida para el panel de KPIs.",
            "props": [
              "label: string",
              "value: string | number",
              "delta?: string",
              "tone?: 'positive' | 'warning' | 'critical' | 'neutral'",
              "loading?: boolean"
            ],
            "notes": "Usa n\u00fameros tabulares, borde sem\u00e1ntico opcional y entrada suave sutil."
          },
          {
            "name": "CustomSelect",
            "role": "Selector de filtros controlado; \u00fanico componente de selecci\u00f3n permitido en el frontend.",
            "props": [
              "value: Option | null",
              "options: Option[]",
              "onChange: (option: Option | null) => void",
              "placeholder?: string",
              "disabled?: boolean"
            ],
            "notes": "Basado en Headless UI. Debe soportar teclado, b\u00fasqueda simple y opciones vac\u00edas."
          },
          {
            "name": "StatusBadge",
            "role": "Pill sem\u00e1ntica para representar el estado del lote.",
            "props": [
              "status: 'ON_TRACK' | 'DELAYED' | 'ON_HOLD' | 'REJECTED'"
            ],
            "notes": "Verde para ON_TRACK, \u00e1mbar para DELAYED/ON_HOLD, rojo para REJECTED. Texto legible y no dependiente solo del color."
          },
          {
            "name": "DataGrid",
            "role": "Tabla central paginada de lotes activos.",
            "props": [
              "columns: Column[]",
              "rows: VaccineBatchRow[]",
              "selectedId?: string",
              "onRowSelect: (id: string) => void",
              "pagination?: PaginationState",
              "loading?: boolean"
            ],
            "notes": "Debe permitir ordenaci\u00f3n, fila seleccionable, estados vac\u00edos y scroll horizontal en pantallas medias."
          },
          {
            "name": "PhaseStepper",
            "role": "L\u00ednea de tiempo de fases del lote entre Campus 1, Campus 2 y Campus 3.",
            "props": [
              "phases: PhaseStep[]",
              "currentPhase: VaccinePhase",
              "orientation?: 'horizontal' | 'vertical'"
            ],
            "notes": "Ilumina fases completadas, marca la actual y bloquea visuales de fases futuras. En m\u00f3vil pasa a vertical."
          },
          {
            "name": "LimsResultCard",
            "role": "Panel de solo lectura de resultados de calidad LIMS.",
            "props": [
              "results: QualityControlResult[]",
              "isLoading?: boolean",
              "batchId: string"
            ],
            "notes": "Muestra checks verdes/rojos por par\u00e1metro y una etiqueta visible de Gating LIMS antes del embalaje."
          },
          {
            "name": "AlertBanner",
            "role": "Banner de alerta prioritaria para desviaciones t\u00e9rmicas o anomal\u00edas de formulaci\u00f3n.",
            "props": [
              "alert: DomainAlert",
              "severity: 'critical' | 'warning' | 'info'",
              "onDismiss?: () => void"
            ],
            "notes": "M\u00e1xima prioridad visual ante alertas operativas. Debe mantener jerarqu\u00eda sin saturar el dashboard."
          },
          {
            "name": "AuditLogItem",
            "role": "Registro visual del historial de fases para auditor\u00eda inmutable.",
            "props": [
              "entry: PhaseLogEntry",
              "showOperator?: boolean"
            ],
            "notes": "Presenta fase, timestamp UTC, operador y evento asociado. Orientado a auditor\u00edas farmac\u00e9uticas."
          }
        ],
        "figma_layout_plan": {
