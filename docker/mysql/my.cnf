[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
skip-character-set-client-handshake
init-connect = "SET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci"

# Identificadores, tablas y binarios en minúsculas para evitar diferencias de
# mayúsculas entre sistemas de ficheros.
lower_case_table_names = 0

# Innodb con el juego de caracteres del contrato de esquema.
#
# Persistencia: InnoDB confirma cada transacción en el log de redo
# (`innodb_flush_log_at_trx_commit = 1`) y la doble escritura protege los
# espacios de tablas frente a una escritura parcial. El volumen `mysql-data`
# conserva los ficheros del directorio de datos entre despliegues.
default_storage_engine = InnoDB
innodb_file_per_table = 1
innodb_buffer_pool_size = 512M
innodb_log_file_size = 128M
innodb_flush_log_at_trx_commit = 1
innodb_doublewrite = 1
innodb_lock_wait_timeout = 60

# Tiempos de espera y de conexión.
max_connections = 200
wait_timeout = 600
interactive_timeout = 600
max_allowed_packet = 64M

# Registro de consultas lentas para el análisis de rendimiento (NFR).
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
